[2.391, "o", "\u001b[1mdeploy.yaml  Deployment/web\u001b[0m\r\n  \u001b[31m\u2716 error  \u001b[0m \u001b[2mKG011\u001b[0m  hostNetwork enabled\u001b[32m [fixable]\u001b[0m\u001b[2m (line 17)\u001b[0m\r\n  \u001b[33m\u26a0 warning\u001b[0m \u001b[2mKG013\u001b[0m  securityContext.seccompProfile is not set to RuntimeDefault or Localhost\u001b[32m [fixable]\u001b[0m\u001b[2m (line 17)\u001b[0m\r\n  \u001b[36m\u2139 info   \u001b[0m \u001b[2mKG014\u001b[0m  automountServiceAccountToken is not false\u001b[2m (line 17)\u001b[0m\r\n  \u001b[36m\u2139 info   \u001b[0m \u001b[2mKG015\u001b[0m  spec.replicas is 1\u001b[2m (line 17)\u001b[0m\r\n  \u001b[31m\u2716 error  \u001b[0m \u001b[2mKG001\u001b[0m  container \"nginx\": missing resources.requests (cpu, memory)\u001b[32m [fixable]\u001b[0m\u001b[2m (line 19)\u001b[0m\r\n  \u001b[31m\u2716 error  \u001b[0m \u001b[2mKG002\u001b[0m  container \"nginx\": missing resources.limits.memory\u001b[32m [fixable]\u001b[0m\u001b[2m (line 19)\u001b[0m\r\n  \u001b[31m\u2716 error  \u001b[0m \u001b[2mKG003\u001b[0m  container \"nginx\": securityContext.runAsNonRoot is not true\u001b[32m [fixable]\u001b[0m\u001b[2m (line 19)\u001b[0m\r\n  \u001b[31m\u2716 error  \u001b[0m \u001b[2mKG004\u001b[0m  container \"nginx\": securityContext.privileged is true\u001b[32m [fixable]\u001b[0m\u001b[2m (line 19)\u001b[0m\r\n  \u001b[33m\u26a0 warning\u001b[0m \u001b[2mKG005\u001b[0m  container \"nginx\": securityContext.allowPrivilegeEscalation is not false\u001b[32m [fixable]\u001b[0m\u001b[2m (line 19)\u001b[0m\r\n  \u001b[33m\u26a0 warning\u001b[0m \u001b[2mKG006\u001b[0m  container \"nginx\": securityContext.readOnlyRootFilesystem is not true\u001b[32m [fixable]\u001b[0m\u001b[2m (line 19)\u001b[0m\r\n  \u001b[33m\u26a0 warning\u001b[0m \u001b[2mKG007\u001b[0m  container \"nginx\": securityContext.capabilities.drop does not include ALL\u001b[32m [fixable]\u001b[0m\u001b[2m (line 19)\u001b[0m\r\n  \u001b[33m\u26a0 warning\u001b[0m \u001b[2mKG008\u001b[0m  container \"nginx\": missing livenessProbe\u001b[2m (line 19)\u001b[0m\r\n  \u001b[33m\u26a0 warning\u001b[0m \u001b[2mKG009\u001b[0m  container \"nginx\": missing readinessProbe\u001b[2m (line 19)\u001b[0m\r\n  \u001b[31m\u2716 error  \u001b[0m \u001b[2mKG010\u001b[0m  container \"nginx\": image \"nginx:latest\" uses the mutable :latest tag\u001b[2m (line 19)\u001b[0m\r\n\r\n"]
[2.391, "o", "6 error(s), 6 warning(s), 2 info\r\n9 issue(s) can be fixed automatically with --fix (add --ai to let Claude fix the rest)\r\n"]
